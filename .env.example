# TendX environment (Build Spec section 13). Copy to .env and fill in.
# The app builds and runs with these defaults and AI fully mocked, so no API
# keys are required to develop locally.

# --- Database (PostgreSQL via Prisma) ---
# Local example. Use a managed Postgres (Neon) in deployment.
# On Neon, DATABASE_URL is the POOLED connection (host has "-pooler") used by the
# serverless app; DIRECT_URL is the DIRECT connection used for migrations/seed.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tendx?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/tendx?schema=public"

# --- Auth.js (NextAuth v5) ---
# Generate a secret with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-long-random-string"
# Base URL of the app (used for callbacks). In production set this to the
# deployed HTTPS URL, e.g. https://your-app.vercel.app (Auth.js then issues
# secure cookies automatically; trustHost is already enabled in lib/auth.config.ts).
AUTH_URL="http://localhost:3000"

# --- AI provider (Build Spec sections 3 and 9) ---
# "mock" runs everything with no API keys (default).
#
# "groq" uses free / open-source models via Groq's OpenAI-compatible endpoint
# (https://api.groq.com/openai/v1). Set AI_PROVIDER="groq" and GROQ_API_KEY
# (free key from https://console.groq.com). The mock is used automatically when
# the key is missing or a request fails / is rate-limited, so the demo never
# breaks. AI_MODEL selects the model (default llama-3.3-70b-versatile).
#
# "anthropic" uses real Claude (ANTHROPIC_API_KEY, ANTHROPIC_MODEL).
#
# In every case eligibility, match score and all tax math stay deterministic.
AI_PROVIDER="mock"

# Groq (free / open-source models)
GROQ_API_KEY=""
AI_MODEL="llama-3.3-70b-versatile"

# Anthropic Claude
ANTHROPIC_API_KEY=""
# Optional model override (defaults to claude-opus-4-8).
ANTHROPIC_MODEL="claude-opus-4-8"
